# ==========================================
# PrepSense AI - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env file to GitHub
# ==========================================

# ==========================================
# REQUIRED VARIABLES (Server won't start without these)
# ==========================================

# JWT Secret - Generate a strong random string (min 32 characters)
# Generate with: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# MongoDB Connection String
# Get from MongoDB Atlas: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/prepsense_ai

# ==========================================
# AI API KEYS (Choose at least one)
# ==========================================

# Option 1: Groq (Recommended - fast, cheap)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Option 2: Google Gemini (Optional alternative)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Option 3: OpenAI (Optional alternative)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# AI Provider Selection (groq, google, or openai)
AI_PROVIDER=groq

# ==========================================
# APPLICATION SETTINGS
# ==========================================

# Node Environment (development, production)
NODE_ENV=production

# Server Port (Render will override this)
PORT=5000

# Frontend URL (for CORS)
# In production, this is your frontend domain
CLIENT_URL=http://localhost:5173

# Allowed Origins (comma-separated for CORS)
# Format: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# OPTIONAL VARIABLES
# ==========================================

# Cloudinary (for image/file uploads)
# Get from: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service (SendGrid)
# Get from: https://sendgrid.com
SENDGRID_API_KEY=SG.your_sendgrid_key

# ==========================================
# DEVELOPMENT ONLY (don't use in production)
# ==========================================

# Enable debug logging
DEBUG=false

# ==========================================
# RENDER-SPECIFIC VARIABLES (Auto-set by Render)
# ==========================================

# Render sets these automatically - don't manually set:
# RENDER=true
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
